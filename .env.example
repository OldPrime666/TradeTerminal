# GCIS Environment — copy to .env and fill only if needed
# No secrets required for PAPER/RESEARCH (Binance public data is free, no key)
# Leave empty for default PAPER mode

# GCIS_APP_MODE=RESEARCH  # RESEARCH | PAPER | LIVE
# GCIS_ENABLE_LIVE_TRADING=false
# GCIS_DATABASE_URL=postgresql+psycopg://gcis:gcis@localhost:5432/gcis
# GCIS_EXCHANGE_REST_BASE=https://data-api.binance.vision
# GCIS_EXCHANGE_WS_BASE=wss://data-stream.binance.vision
# GCIS_BIND_ADDRESS=127.0.0.1

# Optional free provider keys (only for free data providers — never paid)
# COINPAPRIKA_KEY=
# COINLORE_KEY=
# COINDAR_TOKEN=  # free token for Coindar calendar
# TELEGRAM_BOT_TOKEN=  # P2 notifications only

# Security: secrets live only here or OS credential store — never in code/DB/logs/Git (INV-15)
